model StockTransfer {
  id           BigInt   @id @default(autoincrement())
  fromBranchId Int
  fromBranch   Branch   @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toBranchId   Int
  toBranch     Branch   @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transferNo   String   @db.NVarChar(40)
  transferDate DateTime @default(now()) @db.DateTime2
  status       String   @default("DRAFT") @db.NVarChar(20)
  note         String?  @db.NVarChar(250)

  createdById Int
  createdBy   User @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  dispatchedAt   DateTime? @db.DateTime2
  dispatchedById Int?
  dispatchedBy   User?     @relation("StockTransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  inTransitAt DateTime? @db.DateTime2

  receivedAt   DateTime? @db.DateTime2
  receivedById Int?
  receivedBy   User?     @relation("StockTransferReceivedBy", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiveNote  String?   @db.NVarChar(250)

  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2

  items StockTransferItem[]

  @@unique([fromBranchId, transferNo])
  @@index([fromBranchId, transferDate])
  @@index([toBranchId, transferDate])
  @@index([status, transferDate])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         BigInt       @id @default(autoincrement())
  transferId BigInt
