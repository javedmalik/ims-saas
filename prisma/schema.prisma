  qty         Int
  receivedQty Int @default(0)

  destinationBatchId Int?
  destinationBatch   ProductBatch? @relation("TransferDestinationBatch", fields: [destinationBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transferId])
  @@index([sourceBatchId])
  @@map("stock_transfer_items")
}

